{
	"version": "1.1.75",
	"name": "@excali-boards/boards-api-client",
	"description": "A simple API client for the Boards API.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Excali-Boards/boards-api-client.git"
	},
	"author": "Digital39999",
	"scripts": {
		"ts": "pnpm install typescript --save-dev -g",
		"init": "pnpm install && pnpm run build",
		"build": "tsc",
		"postinstall": "prisma generate",
		"watch": "tsc --watch",
		"lint": "eslint .",
		"updates": "pnpm npm-check-updates -i --format group"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"license": "GPL-3.0",
	"files": [
		"dist",
		"prisma/schema",
		"prisma/generated",
		"prisma.config.ts",
		"README.md",
		"LICENSE"
	],
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/client",
			"@prisma/engines",
			"prisma"
		]
	},
	"devDependencies": {
		"@types/node": "20.14.13",
		"@eslint/js": "10.0.1",
		"eslint": "10.0.1",
		"globals": "17.13.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.0"
	},
	"engines": {
		"node": ">=20.2.0"
	},
	"dependencies": {
		"@prisma/client": "6.16.2",
		"axios": "1.12.2",
		"prisma": "6.16.2",
		"zod": "4.1.9"
	}
}
